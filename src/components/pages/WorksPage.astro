---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import intro from '../../data/works_intro.json';
import works from '../../data/works.json';
import { tr, type Lang } from '../../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<BaseLayout lang={lang} route="works" title={lang === 'en' ? 'Works' : 'Karya'} description={tr(intro, 'lead', lang)}>
  <PageHero eyebrow={lang === 'en' ? 'Publications and language work' : 'Publikasi dan karya bahasa'} title={tr(intro, 'title', lang)} lead={tr(intro, 'lead', lang)} />
  <section class="section-sm">
    <div class="narrow notice reveal">{tr(intro, 'note', lang)}</div>
  </section>
  <section class="section">
    <div class="container work-grid">
      {works.map((item) => (
        <article class="work-card reveal">
          <img src={item.image} alt={`${tr(item, 'type', lang)} — ${item.title}`} />
          <div class="work-card-body">
            <p class="meta">{tr(item, 'type', lang)} · {item.year}</p>
            <h2>{item.title}</h2>
            <p>{tr(item, 'description', lang)}</p>
            {item.link && <a class="text-link" href={item.link} target="_blank" rel="noreferrer">{lang === 'en' ? 'Open work' : 'Buka karya'}</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
